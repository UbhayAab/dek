{
  "name": "dek",
  "private": true,
  "type": "module",
  "description": "Dek: internal team chat for Jarurat Care Foundation and Safalta Setu",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:migrate": "node tools/db.mjs migrate",
    "db:status": "node tools/db.mjs status",
    "db:sql": "node tools/db.mjs sql",
    "test:db": "node --test --test-concurrency=1 \"supabase/tests/*.test.mjs\"",
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test:web": "npm --workspace apps/web run test",
    "test": "npm run test:db && npm run test:web",
    "deploy": "node tools/deploy-web.mjs",
    "fn:deploy": "node tools/deploy-fn.mjs",
    "test:db:live": "node --test --test-concurrency=1 supabase/tests/media-live.live.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pg": "^8.23.1"
  }
}
